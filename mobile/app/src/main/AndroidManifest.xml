<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:name=".LivraisonApp"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Livraison"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action   android:name="android.intent.action.MAIN"     />
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Controller flows -->
        <activity android:name=".ui.controller.ControllerHomeActivity"    android:exported="false" />
        <activity android:name=".ui.controller.DeliveriesListActivity"    android:exported="false" />
        <activity android:name=".ui.controller.DashboardActivity"         android:exported="false" />
        <activity android:name=".ui.controller.ControllerMessagingActivity" android:exported="false" />

        <!-- Driver flows -->
        <activity android:name=".ui.driver.DriverHomeActivity"      android:exported="false" />
        <activity android:name=".ui.driver.DeliveryDetailActivity"  android:exported="false" />
        <activity android:name=".ui.driver.EmergencyMessageActivity" android:exported="false" />
    </application>
</manifest>
