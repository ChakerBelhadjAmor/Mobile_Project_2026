<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Material 3 + high-contrast defaults. Large body font size and tall
         buttons are defined here so every screen inherits them — this is
         what makes the driver module usable "under the sun". -->
    <style name="Theme.Livraison" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textSize">18sp</item>
        <item name="materialButtonStyle">@style/Widget.Livraison.Button</item>
    </style>

    <!-- "Fat" buttons: 64dp tall, bold, easy to tap while walking. -->
    <style name="Widget.Livraison.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>
</resources>
